{
  "name": "scenespeak-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-vad-assets.mjs",
    "predev": "node scripts/copy-vad-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vad-assets.mjs && node scripts/copy-reports.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "reports": "node scripts/copy-reports.mjs"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.30",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
