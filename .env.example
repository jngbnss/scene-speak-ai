# Copy to .env and adjust. .env is git-ignored.

# Model adapters. Only "mock" exists in step 1.
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
ALIGNER_PROVIDER=mock

DEFAULT_SCENE_ID=new-york-cafe
# SCENES_DIR=./scenes
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend (Vite). Leave empty to use the dev proxy at /ws/session.
# VITE_WS_URL=ws://127.0.0.1:8000/ws/session
