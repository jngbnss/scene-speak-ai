# Copy to .env and adjust. .env is git-ignored.

# Model adapters. "mock" needs nothing installed (CI uses it).
STT_PROVIDER=mock
# LLM_PROVIDER: mock | ollama
LLM_PROVIDER=mock
TTS_PROVIDER=mock
ALIGNER_PROVIDER=mock

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Qwen3 thinking mode adds seconds per reply
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_S=60

# Learning history
# DATABASE_URL=sqlite:///./data/scenespeak.db
LOW_CONFIDENCE_THRESHOLD=0.6

DEFAULT_SCENE_ID=new-york-cafe
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend (Vite). Leave empty to use the dev proxy at /ws/session.
# VITE_WS_URL=ws://127.0.0.1:8000/ws/session
